---
import '../styles/global.css';
import { joinBase } from '../lib/paths.mjs';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: joinBase(base, ''), label: 'Home' },
  { href: joinBase(base, 'tags/'), label: 'Tags' },
  { href: joinBase(base, 'categories/'), label: 'Categories' },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Applied before first paint so the theme never flashes.
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-svh antialiased">
    <header
      class="border-border/70 bg-background/85 sticky top-0 z-40 border-b backdrop-blur-sm"
    >
      <div
        class="mx-auto flex h-14 max-w-(--container-reading) items-center gap-6 px-6"
      >
        <a
          href={joinBase(base, '')}
          class="hover:text-foreground/70 text-[0.9375rem] font-semibold tracking-tight transition-colors"
        >
          Knowledge catalog
        </a>
        <nav class="flex items-center gap-5 text-sm">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-muted-foreground hover:text-foreground transition-colors"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto">
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-(--container-reading) px-6 pt-14 pb-24">
      <slot />
    </main>
  </body>
</html>
