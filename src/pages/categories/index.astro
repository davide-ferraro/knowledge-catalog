---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TaxonomyGrid from '../../components/TaxonomyGrid.astro';
import { categoryHref } from '../../lib/paths.mjs';
import { visiblePosts } from '../../lib/visibility.mjs';

const posts = visiblePosts(await getCollection('posts'));
const counts = new Map<string, number>();
for (const post of posts) {
  counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
const base = import.meta.env.BASE_URL;
const entries: Array<[string, number, string]> = [...counts.entries()]
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([category, count]) => [category, count, categoryHref(category, base)]);
---

<Base title="Categories">
  <h1 class="text-[2rem] leading-tight font-bold tracking-[-0.02em]">
    Categories
  </h1>
  <p class="text-muted-foreground mt-2 text-sm">
    {entries.length} {entries.length === 1 ? 'category' : 'categories'}.
  </p>
  <TaxonomyGrid entries={entries} />
</Base>
