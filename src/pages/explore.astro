---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { joinBase, postHref } from '../lib/paths.mjs';
import { visiblePosts } from '../lib/visibility.mjs';

const base = import.meta.env.BASE_URL;
const posts = visiblePosts(await getCollection('posts'));

function kindOf(p: (typeof posts)[number]) {
  if (p.data.series === 'eeme') return p.data.chapter ? 'chapter' : 'companion';
  if (p.data.icon === 'gb') return 'gb';
  return 'other';
}
const order = { chapter: 0, companion: 1, gb: 2, other: 3 } as const;
const town = posts
  .map((p) => ({
    title: p.data.title,
    href: postHref(p.id, base),
    kind: kindOf(p),
    num: p.data.chapter ?? null,
    tag:
      kindOf(p) === 'chapter'
        ? `Book, chapter ${p.data.chapter}`
        : kindOf(p) === 'companion'
          ? 'Book companion'
          : kindOf(p) === 'gb'
            ? 'GB market'
            : 'Note',
    sort: order[kindOf(p)] * 1000 + (p.data.chapter ?? 99),
  }))
  .sort((a, b) => a.sort - b.sort)
  .map(({ sort, ...rest }) => rest);

const homeHref = joinBase(base, '');
---

<Base title="Catalog Town" description="Walk around the knowledge catalog. Every house is a post.">
  <div id="game" class="fixed inset-0 z-50 bg-[#07120b]">
    <canvas id="town" class="block" style="image-rendering: pixelated;"></canvas>

    <a
      href={homeHref}
      class="absolute top-3 left-3 rounded-md border border-white/25 bg-black/55 px-3 py-1.5 font-mono text-xs text-white/90 backdrop-blur-sm hover:bg-black/75"
    >
      ← catalog
    </a>

    <div class="absolute top-3 right-3 rounded-md border border-white/25 bg-black/55 px-3 py-2 font-mono text-[11px] leading-relaxed text-white/85 backdrop-blur-sm max-sm:hidden">
      <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-[2px]" style="background:#2b4d7e"></span> book chapters</span>
      <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-[2px]" style="background:#c65a1e"></span> companions</span>
      <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-[2px]" style="background:#0f6b5e"></span> GB market</span>
      <span class="flex items-center gap-1.5"><span class="inline-block size-2 rounded-[2px]" style="background:#8a4a68"></span> other notes</span>
    </div>

    <div
      id="dialog"
      class="pointer-events-none absolute bottom-4 left-1/2 w-[min(92vw,38rem)] -translate-x-1/2 rounded-lg border-[3px] border-[#2c3038] bg-[#f8f8ec] px-4 py-2.5 font-mono text-sm leading-snug text-[#22282e] shadow-[0_4px_0_rgba(0,0,0,0.35)]"
    >
    </div>

    <div id="pad" class="absolute bottom-24 left-4 hidden touch-none select-none" aria-hidden="true">
      <div class="grid grid-cols-3 gap-1 opacity-85">
        <span></span><button data-dir="up" class="pad-btn">▲</button><span></span>
        <button data-dir="left" class="pad-btn">◀</button><span></span><button data-dir="right" class="pad-btn">▶</button>
        <span></span><button data-dir="down" class="pad-btn">▼</button><span></span>
      </div>
    </div>
    <button id="abtn" class="pad-btn absolute right-4 bottom-28 hidden h-14 w-14 rounded-full text-base font-bold" aria-hidden="true">A</button>

    <div id="book" class="absolute inset-0 z-10 hidden items-center justify-center">
      <div class="absolute inset-0 bg-black/60" data-book-close></div>
      <div id="book-panel" class="relative flex h-[90vh] w-[min(95vw,64rem)] scale-95 flex-col rounded-xl border-4 border-[#4c3018] bg-[#8a5a34] p-2 opacity-0 shadow-2xl transition-all duration-200 max-sm:h-[94vh]">
        <div class="flex items-center gap-3 px-2 py-2 font-mono text-xs text-[#f6ecd4] sm:text-sm">
          <span id="book-tag" class="shrink-0 rounded bg-[#5d3d22] px-2 py-0.5 opacity-90"></span>
          <strong id="book-title" class="truncate"></strong>
          <a id="book-open" target="_blank" class="ml-auto shrink-0 underline opacity-80 hover:opacity-100">full page ↗</a>
          <button id="book-close" class="shrink-0 rounded bg-[#5d3d22] px-2.5 py-1 hover:bg-[#4c3018]">✕ Esc</button>
        </div>
        <div class="relative flex-1 overflow-hidden rounded-lg bg-[#f6ecd4]">
          <div class="pointer-events-none absolute top-0 bottom-0 left-6 z-10 w-px bg-[#d9c7a2]"></div>
          <div class="pointer-events-none absolute top-0 right-10 z-10 h-9 w-4 bg-[#c0392b]" style="clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%)"></div>
          <iframe id="book-frame" class="h-full w-full" style="background: transparent" title="Post"></iframe>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="town-data" set:html={JSON.stringify(town)} />

  <style is:global>
    html:has(#game),
    html:has(#game) body {
      overflow: hidden;
      height: 100%;
    }
  </style>
  <style>
    .pad-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      border-radius: 0.6rem;
      background: rgba(14, 20, 16, 0.72);
      color: #f0f4ee;
      border: 1px solid rgba(240, 244, 238, 0.35);
      touch-action: none;
    }
    @media (pointer: coarse) {
      #pad { display: grid; }
      #abtn { display: flex; }
    }
  </style>

  <script>
    type Post = { title: string; href: string; kind: string; tag: string; num: number | null };
    const POSTS: Post[] = JSON.parse(document.getElementById('town-data')!.textContent!);

    /* ================= world ================= */
    const T = 16;
    const PER_ROW = 3;
    const bRows = Math.ceil(POSTS.length / PER_ROW);
    const COLS = 4 + PER_ROW * 10;
    const ROWS = 6 + bRows * 9 + 6;

    const G = 0, PATH = 1, TREE = 2, WATER = 3, FLOWER = 4, SOLID = 5, DOOR = 7, SIGN = 8, TUFT = 9, FENCE = 10;

    const grid: number[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(G));
    const doorAt = new Map<string, number>();
    const signAt = new Map<string, number>();
    type Building = { x: number; y: number; kind: string; idx: number };
    const buildings: Building[] = [];

    function rng(seed: number) {
      let a = seed;
      return () => {
        a |= 0; a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const rand = rng(20260912);

    for (let y = 0; y < ROWS; y++)
      for (let x = 0; x < COLS; x++)
        if (y < 2 || y >= ROWS - 2 || x < 2 || x >= COLS - 2) grid[y][x] = TREE;

    POSTS.forEach((p, i) => {
      const r = Math.floor(i / PER_ROW), c = i % PER_ROW;
      const bx = 4 + c * 10, by = 4 + r * 9;
      buildings.push({ x: bx, y: by, kind: p.kind, idx: i });
      for (let yy = by; yy < by + 4; yy++)
        for (let xx = bx; xx < bx + 5; xx++) grid[yy][xx] = SOLID;
      grid[by + 3][bx + 2] = DOOR;
      doorAt.set(`${bx + 2},${by + 3}`, i);
      const py = by + 4;
      for (let xx = 3; xx < COLS - 3; xx++) grid[py][xx] = PATH;
      grid[by + 3][bx - 1] = SIGN;
      signAt.set(`${bx - 1},${by + 3}`, i);
      // little yard fence to the right of each house
      if (grid[by + 3][bx + 5] === G) grid[by + 3][bx + 5] = FENCE;
      if (grid[by + 3][bx + 6] === G) grid[by + 3][bx + 6] = FENCE;
    });

    const cx = Math.floor(COLS / 2);
    for (let yy = 4; yy < ROWS - 3; yy++)
      if (grid[yy][cx] === G || grid[yy][cx] === FLOWER) grid[yy][cx] = PATH;
    for (let yy = ROWS - 5; yy < ROWS - 2; yy++)
      for (let xx = cx - 2; xx <= cx + 2; xx++)
        if (grid[yy][xx] === G) grid[yy][xx] = PATH;
    for (let yy = ROWS - 6; yy < ROWS - 3; yy++)
      for (let xx = 4; xx < 9; xx++)
        if (grid[yy][xx] === G) grid[yy][xx] = WATER;

    // fenced flower garden east of the plaza
    {
      const gx = cx + 5, gy = ROWS - 7;
      for (let yy = gy; yy < gy + 4; yy++)
        for (let xx = gx; xx < gx + 6; xx++) {
          if (xx >= COLS - 2 || grid[yy][xx] !== G) continue;
          const edge = yy === gy || yy === gy + 3 || xx === gx || xx === gx + 5;
          grid[yy][xx] = edge ? FENCE : FLOWER;
        }
      if (grid[gy + 1]?.[gx] === FENCE) grid[gy + 1][gx] = G; // gate gap
    }

    for (let y = 2; y < ROWS - 2; y++)
      for (let x = 2; x < COLS - 2; x++) {
        if (grid[y][x] !== G) continue;
        const v = rand();
        if (v < 0.05) grid[y][x] = FLOWER;
        else if (v < 0.11) grid[y][x] = TUFT;
        else if (v < 0.135 && y > 5) grid[y][x] = TREE;
      }

    const blocked = (x: number, y: number) => {
      if (x < 0 || y < 0 || x >= COLS || y >= ROWS) return true;
      const t = grid[y][x];
      return t === TREE || t === WATER || t === SOLID || t === SIGN || t === FENCE;
    };

    /* ================= sprite factory ================= */
    function sheet(w: number, h: number) {
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const g = c.getContext('2d')!;
      g.imageSmoothingEnabled = false;
      return [c, g] as const;
    }
    /** dark outline around every opaque region */
    function outline(c: HTMLCanvasElement, color = '#20180f') {
      const g = c.getContext('2d')!;
      const { width: w, height: h } = c;
      const src = g.getImageData(0, 0, w, h);
      const out = g.createImageData(w, h);
      out.data.set(src.data);
      const a = (x: number, y: number) =>
        x >= 0 && y >= 0 && x < w && y < h && src.data[(y * w + x) * 4 + 3] > 40;
      const [r, gg, b] = [
        parseInt(color.slice(1, 3), 16),
        parseInt(color.slice(3, 5), 16),
        parseInt(color.slice(5, 7), 16),
      ];
      for (let y = 0; y < h; y++)
        for (let x = 0; x < w; x++) {
          const i = (y * w + x) * 4;
          if (src.data[i + 3] > 40) continue;
          if (a(x - 1, y) || a(x + 1, y) || a(x, y - 1) || a(x, y + 1)) {
            out.data[i] = r; out.data[i + 1] = gg; out.data[i + 2] = b; out.data[i + 3] = 255;
          }
        }
      g.putImageData(out, 0, 0);
      return c;
    }
    const px = (g: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, c: string) => {
      g.fillStyle = c; g.fillRect(x, y, w, h);
    };

    /* --- terrain tiles (warm Stardew-ish palette) --- */
    const tileRand = rng(77);
    function grassTile(_v: number) {
      const [c, g] = sheet(T, T);
      px(g, 0, 0, T, T, '#7daf4e');
      for (let i = 0; i < 26; i++) {
        const x = Math.floor(tileRand() * T), y = Math.floor(tileRand() * T);
        const r = tileRand();
        px(g, x, y, 1, 1, r < 0.4 ? '#86ba57' : r < 0.7 ? '#74a446' : '#8fc262');
      }
      for (let i = 0; i < 3; i++) {
        const x = Math.floor(tileRand() * 13), y = Math.floor(tileRand() * 12);
        px(g, x, y, 1, 2, '#68983f'); px(g, x + 1, y + 1, 1, 1, '#68983f');
      }
      return c;
    }
    function tuftTile() {
      const c = grassTile(0), g = c.getContext('2d')!;
      for (const [x, y] of [[3, 8], [8, 5], [11, 10]] as const) {
        px(g, x, y, 1, 4, '#55913c');
        px(g, x - 1, y + 1, 1, 3, '#68a94a'); px(g, x + 1, y + 1, 1, 3, '#68a94a');
        px(g, x, y, 1, 1, '#7fbf5c');
      }
      return c;
    }
    function flowerTile(alt: boolean) {
      const c = grassTile(0), g = c.getContext('2d')!;
      const plot = (x: number, y: number, col: string) => {
        px(g, x, y + 2, 1, 3, '#457a30');
        px(g, x - 1, y + 3, 1, 1, '#457a30');
        px(g, x, y - 1, 1, 1, col); px(g, x, y + 1, 1, 1, col);
        px(g, x - 1, y, 1, 1, col); px(g, x + 1, y, 1, 1, col);
        px(g, x, y, 1, 1, '#fff3c4');
      };
      plot(4, 4, alt ? '#e0563e' : '#f0cf46');
      plot(11, 8, alt ? '#f0cf46' : '#df8fc4');
      if (alt) plot(7, 12, '#e9e6f0');
      return c;
    }
    function pathTile() {
      const [c, g] = sheet(T, T);
      px(g, 0, 0, T, T, '#bb9059');
      for (let i = 0; i < 14; i++) {
        const x = Math.floor(tileRand() * T), y = Math.floor(tileRand() * T);
        const r = tileRand();
        px(g, x, y, 2, 1, r < 0.45 ? '#ad8450' : r < 0.75 ? '#c79c64' : '#a1794a');
      }
      const nPebbles = Math.floor(tileRand() * 3); // 0 to 2 per variant
      for (let i = 0; i < nPebbles; i++) {
        const x = 2 + Math.floor(tileRand() * 12), y = 2 + Math.floor(tileRand() * 12);
        px(g, x, y, 2, 2, tileRand() < 0.5 ? '#93a08c' : '#a8b3a0');
        px(g, x, y, 2, 1, '#b8c2b0');
      }
      return c;
    }
    function waterTile(f: number) {
      const [c, g] = sheet(T, T);
      px(g, 0, 0, T, T, '#2e7ba8');
      px(g, 0, 0, T, 3, '#296e98');
      const o = f ? 3 : 0;
      px(g, 2 + o, 5, 5, 1, '#5fa7cc'); px(g, 9 - o, 10, 5, 1, '#5fa7cc');
      px(g, 5 + o, 13, 3, 1, '#3f8ab4');
      px(g, 12, 3 + o, 2, 1, '#8ec6de');
      return c;
    }
    function lilyTile(f: number) {
      const c = waterTile(f), g = c.getContext('2d')!;
      px(g, 4, 6 + (f ? 1 : 0), 5, 4, '#3f8f3f');
      px(g, 5, 7 + (f ? 1 : 0), 3, 2, '#54a94c');
      px(g, 8, 6 + (f ? 1 : 0), 2, 2, '#2e7ba8'); // notch
      return c;
    }
    /* --- objects --- */
    function treeSprite() {
      const [c, g] = sheet(20, 30);
      px(g, 8, 22, 4, 7, '#6e4a2c'); px(g, 8, 22, 1, 7, '#573a22');
      px(g, 11, 24, 2, 1, '#8a6238');
      // lush layered canopy
      px(g, 3, 8, 14, 13, '#2c7a3c');
      px(g, 2, 10, 16, 8, '#2c7a3c');
      px(g, 4, 4, 12, 8, '#3c9450');
      px(g, 6, 2, 8, 4, '#4aa65c');
      px(g, 5, 4, 5, 3, '#63bd72'); px(g, 12, 7, 4, 3, '#63bd72');
      px(g, 3, 14, 4, 4, '#1f5e2d'); px(g, 12, 15, 5, 4, '#1f5e2d');
      px(g, 8, 18, 4, 3, '#1f5e2d');
      px(g, 7, 3, 3, 1, '#8fd69b');
      return outline(c);
    }
    function pineSprite() {
      const [c, g] = sheet(18, 30);
      px(g, 7, 24, 4, 5, '#6e4a2c'); px(g, 7, 24, 1, 5, '#573a22');
      px(g, 2, 16, 14, 8, '#1d6230');
      px(g, 4, 10, 10, 8, '#2a7a3e');
      px(g, 6, 5, 6, 7, '#38904c');
      px(g, 8, 2, 2, 5, '#48a45a');
      px(g, 6, 10, 2, 2, '#5cb96c'); px(g, 4, 17, 2, 2, '#5cb96c');
      return outline(c);
    }
    function fenceSprite() {
      const [c, g] = sheet(16, 18);
      px(g, 2, 4, 3, 12, '#a0693a'); px(g, 2, 4, 3, 2, '#c08a50');
      px(g, 11, 4, 3, 12, '#a0693a'); px(g, 11, 4, 3, 2, '#c08a50');
      px(g, 0, 7, 16, 2, '#b3794a');
      px(g, 0, 12, 16, 2, '#b3794a');
      return outline(c);
    }
    function signSprite() {
      const [c, g] = sheet(16, 18);
      px(g, 7, 9, 2, 7, '#6b4a2f');
      px(g, 2, 2, 12, 8, '#b3854f');
      px(g, 2, 2, 12, 1, '#c9a06a'); px(g, 2, 9, 12, 1, '#8a6238');
      px(g, 4, 4, 8, 1, '#7a5636'); px(g, 4, 6, 6, 1, '#7a5636');
      return outline(c);
    }
    const ROOF: Record<string, [string, string, string]> = {
      chapter: ['#2b4d7e', '#223d64', '#3d639c'],
      companion: ['#c65a1e', '#9c4414', '#e07a35'],
      gb: ['#0f6b5e', '#0a4c43', '#1d8a79'],
      other: ['#8a4a68', '#6b3750', '#a5627f'],
    };
    /* tiny 3x5 pixel digits for plaques */
    const DIG = [
      '111101101101111', '010110010010111', '111001111100111', '111001111001111',
      '101101111001001', '111100111001111', '111100111101111', '111001010010010',
      '111101111101111', '111101111001111',
    ];
    function drawNum(g: CanvasRenderingContext2D, n: number, x: number, y: number, col: string) {
      String(n).split('').forEach((ch, i) => {
        const d = DIG[+ch];
        for (let r = 0; r < 5; r++)
          for (let cc = 0; cc < 3; cc++)
            if (d[r * 3 + cc] === '1') px(g, x + i * 4 + cc, y + r, 1, 1, col);
      });
    }

    type Built = { img: HTMLCanvasElement; anchor: number; smoke: [number, number] | null };

    /* shared pieces: door spans sprite x 34..54 so it sits on the door tile */
    function doorAt34(g: CanvasRenderingContext2D, top: number, bottom: number) {
      px(g, 34, top, 20, bottom - top, '#4c3018');
      px(g, 36, top + 2, 16, bottom - top - 2, '#7a5230');
      px(g, 43, top + 2, 2, bottom - top - 2, '#5d3d22');
      px(g, 36, top + 2, 16, 2, '#8f6339');
      px(g, 49, top + 11, 2, 2, '#e8c96a');
      px(g, 30, bottom, 28, 3, '#a8a294');
    }
    function windowBox(g: CanvasRenderingContext2D, wx: number, wy: number, flowers = true) {
      px(g, wx - 3, wy, 3, 12, '#8a5a30'); px(g, wx + 14, wy, 3, 12, '#8a5a30');
      px(g, wx, wy, 14, 12, '#5d3d22');
      px(g, wx + 1, wy + 1, 12, 10, '#a8dcf5');
      px(g, wx + 1, wy + 1, 12, 4, '#d6f0fb');
      px(g, wx + 6, wy + 1, 1, 10, '#5d3d22'); px(g, wx + 1, wy + 6, 12, 1, '#5d3d22');
      px(g, wx - 1, wy + 12, 16, 2, '#b3794a');
      if (flowers) {
        px(g, wx, wy + 14, 14, 3, '#3d7a2f');
        px(g, wx + 2, wy + 14, 2, 2, '#e0563e'); px(g, wx + 8, wy + 14, 2, 2, '#f0cf46');
      }
    }
    function foundation(g: CanvasRenderingContext2D, y: number) {
      px(g, 4, y, 80, 6, '#9b968a');
      px(g, 4, y, 80, 1, '#b3ada0');
      for (let x = 8; x < 84; x += 10) px(g, x, y + 2, 4, 3, '#847f74');
    }
    function gableRoof(g: CanvasRenderingContext2D, roof: string, dark: string, light: string, top: number, h: number) {
      px(g, 0, top + 8, 88, h - 8, roof);
      px(g, 4, top + 3, 80, 7, roof);
      px(g, 10, top, 68, 5, roof);
      px(g, 10, top, 68, 2, light);
      for (let y = top + 10; y < top + h - 2; y += 5) px(g, 0, y, 88, 1, dark);
      px(g, 0, top + h - 4, 88, 4, dark);
      px(g, 0, top + 8, 3, h - 8, dark); px(g, 85, top + 8, 3, h - 8, dark);
    }

    /** chapter posts: the town library, two floors, plaque with the chapter number */
    function librarySprite(num: number | null): Built {
      const H = 92, [c, g] = sheet(88, H);
      const [roof, dark, light] = ROOF.chapter;
      px(g, 6, 86, 76, 4, 'rgba(30,24,12,0.30)');
      // upper floor
      px(g, 8, 30, 72, 16, '#e6d3a8');
      for (let x = 16, i = 0; x < 80; x += 8, i++) px(g, x, 30, 1, 16, '#d3bd8c');
      px(g, 8, 30, 72, 2, 'rgba(60,36,12,0.35)');
      windowBox(g, 22, 32, false); windowBox(g, 52, 32, false);
      // lower floor
      px(g, 4, 46, 80, 34, '#d9a866');
      for (let x = 12; x < 84; x += 8) px(g, x, 46, 1, 34, '#c3924f');
      px(g, 4, 46, 80, 3, 'rgba(60,36,12,0.30)');
      foundation(g, 80);
      windowBox(g, 12, 56); windowBox(g, 62, 56);
      doorAt34(g, 58, 86);
      // open-book emblem over the door
      px(g, 38, 50, 12, 6, '#f6ecd4'); px(g, 43, 50, 2, 6, '#c9b183');
      px(g, 38, 55, 12, 1, '#8a5a30');
      // plaque with chapter number
      if (num !== null) {
        px(g, 56, 60, 12, 9, '#3a2c1a'); px(g, 57, 61, 10, 7, '#e8c96a');
        drawNum(g, num, num > 9 ? 58 : 60, 62, '#3a2c1a');
      }
      gableRoof(g, roof, dark, light, 6, 24);
      px(g, 64, 0, 10, 10, '#9a5b43'); px(g, 62, 0, 14, 3, '#6e3f2e');
      return { img: outline(c), anchor: 86, smoke: [68, -4] };
    }

    /** companion posts: the workshop, ember roof, stack pipe, barrel */
    function workshopSprite(): Built {
      const H = 76, [c, g] = sheet(88, H);
      const [roof, dark, light] = ROOF.companion;
      px(g, 6, 70, 76, 4, 'rgba(30,24,12,0.30)');
      px(g, 4, 38, 80, 26, '#c89858');
      for (let x = 12; x < 84; x += 8) px(g, x, 38, 1, 26, '#b28448');
      px(g, 4, 38, 80, 3, 'rgba(60,36,12,0.35)');
      foundation(g, 64);
      // round vent window
      px(g, 14, 44, 10, 10, '#5d3d22'); px(g, 16, 46, 6, 6, '#a8dcf5');
      px(g, 18, 46, 2, 6, '#d6f0fb');
      // tool sign: crossed hammer
      px(g, 60, 44, 14, 12, '#8a5a30'); px(g, 61, 45, 12, 10, '#e6d3a8');
      px(g, 63, 47, 8, 2, '#5d3d22'); px(g, 66, 47, 2, 7, '#5d3d22');
      doorAt34(g, 48, 70);
      px(g, 31, 45, 26, 3, dark); px(g, 31, 44, 26, 1, light);
      gableRoof(g, roof, dark, light, 14, 24);
      // metal stack pipe
      px(g, 66, 2, 8, 14, '#7d8288'); px(g, 64, 2, 12, 3, '#5a5f66');
      px(g, 66, 8, 8, 2, '#6b7076');
      // barrel by the wall
      px(g, 6, 54, 12, 16, '#8a5a34'); px(g, 6, 54, 12, 2, '#6e4426');
      px(g, 6, 60, 12, 2, '#5d3d22'); px(g, 6, 66, 12, 2, '#5d3d22');
      px(g, 8, 56, 3, 3, '#a87c4f');
      return { img: outline(c), anchor: 70, smoke: [70, -4] };
    }

    /** the GB post: a proper pub, half-timbered, hanging sign, lantern */
    function pubSprite(): Built {
      const H = 76, [c, g] = sheet(88, H);
      const [roof, dark, light] = ROOF.gb;
      px(g, 6, 70, 76, 4, 'rgba(30,24,12,0.30)');
      // cream plaster with dark timber frame
      px(g, 4, 38, 80, 26, '#efe3c4');
      px(g, 4, 38, 80, 2, '#4c3a26'); px(g, 4, 62, 80, 2, '#4c3a26');
      for (const x of [4, 28, 58, 82]) px(g, x, 38, 2, 26, '#4c3a26');
      // diagonal braces
      for (let i = 0; i < 8; i++) { px(g, 8 + i * 2, 58 - i * 2, 2, 2, '#4c3a26'); px(g, 80 - i * 2, 58 - i * 2, 2, 2, '#4c3a26'); }
      px(g, 4, 38, 80, 3, 'rgba(60,36,12,0.30)');
      foundation(g, 64);
      windowBox(g, 12, 46); windowBox(g, 64, 46);
      // warm lit windows
      px(g, 13, 47, 12, 10, '#f5c86a'); px(g, 65, 47, 12, 10, '#f5c86a');
      px(g, 19, 47, 1, 10, '#5d3d22'); px(g, 13, 52, 12, 1, '#5d3d22');
      px(g, 71, 47, 1, 10, '#5d3d22'); px(g, 65, 52, 12, 1, '#5d3d22');
      doorAt34(g, 48, 70);
      // hanging pub sign
      px(g, 55, 44, 10, 1, '#4c3a26'); px(g, 59, 45, 1, 3, '#4c3a26');
      px(g, 55, 48, 10, 8, '#0f6b5e'); px(g, 56, 49, 8, 6, '#1d8a79');
      px(g, 58, 50, 4, 4, '#f0cf46'); // pint
      // lantern
      px(g, 28, 50, 4, 5, '#f5c86a'); px(g, 28, 48, 4, 2, '#4c3a26'); px(g, 29, 55, 2, 1, '#4c3a26');
      gableRoof(g, roof, dark, light, 14, 24);
      px(g, 16, 2, 10, 14, '#9a5b43'); px(g, 14, 2, 14, 3, '#6e3f2e');
      return { img: outline(c), anchor: 70, smoke: [20, -4] };
    }

    /** everything else: the cottage */
    function cottageSprite(): Built {
      const H = 76, [c, g] = sheet(88, H);
      const [roof, dark, light] = ROOF.other;
      px(g, 6, 70, 76, 4, 'rgba(30,24,12,0.30)');
      px(g, 4, 38, 80, 26, '#d9a866');
      for (let x = 12; x < 84; x += 8) px(g, x, 38, 1, 26, '#c3924f');
      px(g, 4, 44, 80, 1, '#c3924f');
      px(g, 4, 38, 80, 3, 'rgba(60,36,12,0.35)');
      foundation(g, 64);
      windowBox(g, 12, 46); windowBox(g, 62, 46);
      doorAt34(g, 48, 70);
      px(g, 31, 45, 26, 3, dark); px(g, 31, 44, 26, 1, light);
      gableRoof(g, roof, dark, light, 14, 24);
      px(g, 64, 0, 10, 12, '#9a5b43'); px(g, 66, 3, 2, 2, '#7c4634');
      px(g, 62, 0, 14, 3, '#6e3f2e');
      return { img: outline(c), anchor: 70, smoke: [68, -4] };
    }

    function buildFor(kind: string, num: number | null): Built {
      if (kind === 'chapter') return librarySprite(num);
      if (kind === 'companion') return workshopSprite();
      if (kind === 'gb') return pubSprite();
      return cottageSprite();
    }
    /* --- player, auto-outlined pixel villager --- */
    function playerSprite(dir: string, frame: number) {
      const [c, g] = sheet(16, 20);
      const S = '#f2c896', Sd = '#dca878', H = '#6b4226', Hl = '#8a5a34',
        C = '#2b4d7e', Cl = '#3d639c', L = '#3a3f47', B = '#5d3d22';
      const ox = 2, oy = 2;
      const P = (x: number, y: number, w: number, h: number, col: string) => px(g, ox + x, oy + y, w, h, col);
      // legs and boots (walk cycle)
      const lu = frame === 1 ? 1 : 0, ru = frame === 2 ? 1 : 0;
      P(3, 12 - lu, 2, 3, L); P(7, 12 - ru, 2, 3, L);
      P(3, 15 - lu, 2, 1, B); P(7, 15 - ru, 2, 1, B);
      // body
      P(2, 7, 8, 5, C);
      P(5, 7, 2, 5, Cl);
      // arms
      const swing = frame === 0 ? 0 : frame === 1 ? 1 : -1;
      P(1, 8 + swing, 1, 3, C); P(10, 8 - swing, 1, 3, C);
      P(1, 11 + swing, 1, 1, S); P(10, 11 - swing, 1, 1, S);
      // head
      P(2, 1, 8, 6, S);
      P(2, 5, 8, 1, Sd);
      // hair
      P(1, 0, 10, 2, H); P(2, -1, 8, 1, H);
      P(1, 2, 1, 3, H); P(10, 2, 1, 3, H);
      P(3, 0, 3, 1, Hl);
      if (dir === 'up') { P(2, 1, 8, 5, H); P(3, 1, 3, 2, Hl); }
      if (dir === 'down') { P(4, 3, 1, 2, '#22282e'); P(7, 3, 1, 2, '#22282e'); }
      if (dir === 'side') { P(2, 1, 3, 5, H); P(7, 3, 1, 2, '#22282e'); P(9, 4, 1, 1, Sd); }
      return outline(c, '#1d1812');
    }

    const SPR = {
      grass: [grassTile(0), grassTile(1), grassTile(2), grassTile(3)],
      tuft: tuftTile(),
      flower: [flowerTile(false), flowerTile(true)],
      path: [pathTile(), pathTile(), pathTile()],
      water: [waterTile(0), waterTile(1)],
      lily: [lilyTile(0), lilyTile(1)],
      tree: treeSprite(),
      pine: pineSprite(),
      fence: fenceSprite(),
      sign: signSprite(),
      player: {
        down: [0, 1, 2].map((f) => playerSprite('down', f)),
        up: [0, 1, 2].map((f) => playerSprite('up', f)),
        side: [0, 1, 2].map((f) => playerSprite('side', f)),
      },
    };
    const hash = (x: number, y: number) => ((x * 73856093) ^ (y * 19349663)) >>> 0;
    const HOUSES: Built[] = buildings.map((b) => buildFor(b.kind, POSTS[b.idx].num));

    /* ================= canvas & camera ================= */
    const canvas = document.getElementById('town') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    let SCALE = 3;
    function resize() {
      const w = window.innerWidth, h = window.innerHeight;
      SCALE = w < 640 ? 2 : w > 1900 ? 4 : 3;
      canvas.width = Math.ceil(w / SCALE);
      canvas.height = Math.ceil(h / SCALE);
      canvas.style.width = `${canvas.width * SCALE}px`;
      canvas.style.height = `${canvas.height * SCALE}px`;
      ctx.imageSmoothingEnabled = false;
    }
    resize();
    window.addEventListener('resize', resize);

    /* ================= state ================= */
    const player = {
      tx: cx, ty: ROWS - 4,
      x: cx * T, y: (ROWS - 4) * T,
      dir: 'up', moving: false, from: [0, 0], to: [0, 0], t0: 0,
    };
    const SPEED = 170;
    const held = new Set<string>();
    const dialog = document.getElementById('dialog')!;
    const DIRS: Record<string, [number, number]> = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] };

    function tryMove(dir: string) {
      if (player.moving || bookOpen) return;
      player.dir = dir;
      const [dx, dy] = DIRS[dir];
      const nx = player.tx + dx, ny = player.ty + dy;
      if (blocked(nx, ny)) return;
      player.moving = true;
      player.from = [player.tx * T, player.ty * T];
      player.to = [nx * T, ny * T];
      player.tx = nx; player.ty = ny;
      player.t0 = performance.now();
    }
    function currentPost(): Post | null {
      const d = doorAt.get(`${player.tx},${player.ty}`);
      if (d !== undefined) return POSTS[d];
      const [dx, dy] = DIRS[player.dir];
      const s = signAt.get(`${player.tx + dx},${player.ty + dy}`);
      return s !== undefined ? POSTS[s] : null;
    }
    /* ---------- the notebook ---------- */
    const book = document.getElementById('book')!;
    const bookPanel = document.getElementById('book-panel')!;
    const bookFrame = document.getElementById('book-frame') as HTMLIFrameElement;
    let bookOpen = false;

    bookFrame.addEventListener('load', () => {
      const doc = bookFrame.contentDocument;
      if (!doc || !doc.head) return;
      doc.documentElement.classList.remove('dark'); // ink on paper, always
      const s = doc.createElement('style');
      s.textContent = `
        header { display: none !important; }
        html, body { background: transparent !important; }
        main { padding-top: 1.5rem !important; padding-bottom: 3rem !important; }
        article, main { color: #38301f; }
        h1, h2, h3, h4, figcaption { color: #2c2413 !important; }
      `;
      doc.head.appendChild(s);
    });

    function enter() {
      const p = currentPost();
      if (!p || bookOpen) return;
      bookOpen = true;
      held.clear();
      dialog.style.visibility = 'hidden';
      document.getElementById('book-tag')!.textContent = p.tag;
      document.getElementById('book-title')!.textContent = p.title;
      (document.getElementById('book-open') as HTMLAnchorElement).href = p.href;
      bookFrame.src = p.href;
      book.style.display = 'flex';
      requestAnimationFrame(() => {
        bookPanel.style.opacity = '1';
        bookPanel.style.transform = 'scale(1)';
      });
    }
    function closeBook() {
      if (!bookOpen) return;
      bookOpen = false;
      bookPanel.style.opacity = '0';
      bookPanel.style.transform = 'scale(0.95)';
      setTimeout(() => {
        book.style.display = 'none';
        bookFrame.src = 'about:blank';
      }, 200);
      dialog.style.visibility = '';
      updateDialog();
    }
    document.getElementById('book-close')!.addEventListener('click', closeBook);
    document.querySelector('[data-book-close]')!.addEventListener('click', closeBook);
    function updateDialog() {
      const p = currentPost();
      dialog.innerHTML = p
        ? `<span style="opacity:.55">${p.tag}</span><br><strong>${p.title}</strong> · press <kbd>Enter</kbd> (or A) to read`
        : 'Welcome to Catalog Town. Every house is a post: walk to a door and press <kbd>Enter</kbd> to read it.';
    }

    const KEYMAP: Record<string, string> = {
      ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
      w: 'up', s: 'down', a: 'left', d: 'right', W: 'up', S: 'down', A: 'left', D: 'right',
    };
    window.addEventListener('keydown', (e) => {
      if (bookOpen) {
        if (e.key === 'Escape') { closeBook(); e.preventDefault(); }
        return;
      }
      const d = KEYMAP[e.key];
      if (d) { held.add(d); tryMove(d); e.preventDefault(); }
      if (e.key === 'Enter' || e.key === ' ') { enter(); e.preventDefault(); }
    });
    window.addEventListener('keyup', (e) => { const d = KEYMAP[e.key]; if (d) held.delete(d); });
    document.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => {
      const d = b.dataset.dir!;
      b.addEventListener('pointerdown', (e) => { e.preventDefault(); held.add(d); tryMove(d); });
      for (const ev of ['pointerup', 'pointerleave', 'pointercancel'])
        b.addEventListener(ev, () => held.delete(d));
    });
    document.getElementById('abtn')!.addEventListener('pointerdown', (e) => { e.preventDefault(); enter(); });

    /* ================= render loop ================= */
    function frame(time: number) {
      if (player.moving) {
        const k = Math.min((time - player.t0) / SPEED, 1);
        player.x = player.from[0] + (player.to[0] - player.from[0]) * k;
        player.y = player.from[1] + (player.to[1] - player.from[1]) * k;
        if (k >= 1) { player.moving = false; updateDialog(); }
      }
      if (!player.moving)
        for (const d of ['up', 'down', 'left', 'right']) if (held.has(d)) { tryMove(d); break; }

      const VW = canvas.width, VH = canvas.height;
      const worldW = COLS * T, worldH = ROWS * T;
      const camX = Math.round(Math.max(0, Math.min(player.x - VW / 2 + T / 2, Math.max(worldW - VW, 0))));
      const camY = Math.round(Math.max(0, Math.min(player.y - VH / 2 + T / 2, Math.max(worldH - VH, 0))));

      ctx.fillStyle = '#0c3b1e';
      ctx.fillRect(0, 0, VW, VH);

      const x0 = Math.max(0, Math.floor(camX / T)), y0 = Math.max(0, Math.floor(camY / T));
      const x1 = Math.min(COLS - 1, Math.ceil((camX + VW) / T)), y1 = Math.min(ROWS - 1, Math.ceil((camY + VH) / T));

      const waterF = Math.floor(time / 550) % 2;
      // base pass
      for (let y = y0; y <= y1; y++)
        for (let x = x0; x <= x1; x++) {
          const t = grid[y][x];
          const sx = x * T - camX, sy = y * T - camY;
          const isPath = (v: number | undefined) => v === PATH || v === DOOR;
          if (t === PATH || t === DOOR) {
            ctx.drawImage(SPR.path[hash(x, y) % 3], sx, sy);
            ctx.fillStyle = '#8f6a3d';
            if (!isPath(grid[y - 1]?.[x]) && grid[y - 1]?.[x] !== SOLID) ctx.fillRect(sx, sy, T, 1);
            if (!isPath(grid[y + 1]?.[x])) ctx.fillRect(sx, sy + T - 1, T, 1);
            if (!isPath(grid[y][x - 1])) ctx.fillRect(sx, sy, 1, T);
            if (!isPath(grid[y][x + 1])) ctx.fillRect(sx + T - 1, sy, 1, T);
            // grass creeping over the edge
            ctx.fillStyle = '#7daf4e';
            if (!isPath(grid[y][x - 1]) && hash(x, y) % 4 === 0) ctx.fillRect(sx, sy + 4, 1, 3);
            if (!isPath(grid[y][x + 1]) && hash(x, y) % 4 === 1) ctx.fillRect(sx + T - 1, sy + 8, 1, 3);
          } else if (t === WATER) {
            const lily = hash(x, y) % 7 === 0;
            ctx.drawImage((lily ? SPR.lily : SPR.water)[waterF], sx, sy);
            // dark earth banks
            ctx.fillStyle = '#5e4a33';
            if (grid[y - 1]?.[x] !== WATER) ctx.fillRect(sx, sy, T, 2);
            if (grid[y + 1]?.[x] !== WATER) ctx.fillRect(sx, sy + T - 2, T, 2);
            if (grid[y][x - 1] !== WATER) ctx.fillRect(sx, sy, 2, T);
            if (grid[y][x + 1] !== WATER) ctx.fillRect(sx + T - 2, sy, 2, T);
          } else if (t === FLOWER) ctx.drawImage(SPR.flower[(x + y) % 2], sx, sy);
          else if (t === TUFT) ctx.drawImage(SPR.tuft, sx, sy);
          else ctx.drawImage(SPR.grass[hash(x, y) % 4], sx, sy);
        }

      // object pass, y-sorted for occlusion
      type Obj = { y: number; draw: () => void };
      const objs: Obj[] = [];
      const active = currentPost();
      for (const b of buildings) {
        const built = HOUSES[b.idx];
        objs.push({
          y: (b.y + 4) * T,
          draw: () => {
            const sx = b.x * T - 4 - camX;
            const sy = (b.y + 4) * T - built.anchor - camY;
            ctx.drawImage(built.img, sx, sy);
            if (active && POSTS[b.idx] === active) {
              ctx.fillStyle = 'rgba(255,238,150,0.85)';
              ctx.fillRect(b.x * T + 2 * T + 3 - camX, b.y * T + 3 * T + 2 - camY, T - 6, 5);
            }
            if (built.smoke) {
              const ph = (time / 900 + b.idx) % 2;
              ctx.fillStyle = 'rgba(235,235,225,0.45)';
              ctx.fillRect(sx + built.smoke[0], sy + built.smoke[1] - ph * 3, 3, 3);
              ctx.fillRect(sx + built.smoke[0] + 3, sy + built.smoke[1] - 5 - ph * 3, 2, 2);
            }
          },
        });
      }
      signAt.forEach((_, key) => {
        const [x, y] = key.split(',').map(Number);
        objs.push({ y: (y + 1) * T, draw: () => ctx.drawImage(SPR.sign, x * T - camX, y * T - 2 - camY) });
      });
      for (let y = y0; y <= Math.min(ROWS - 1, y1 + 1); y++)
        for (let x = x0; x <= x1; x++) {
          const t = grid[y][x];
          if (t === TREE) {
            const border = x < 2 || y < 2 || x >= COLS - 2 || y >= ROWS - 2;
            const pine = border ? hash(x, y) % 3 !== 0 : hash(x, y) % 4 === 0;
            objs.push({
              y: (y + 1) * T,
              draw: () =>
                pine
                  ? ctx.drawImage(SPR.pine, x * T - 1 - camX, y * T - 13 - camY)
                  : ctx.drawImage(SPR.tree, x * T - 2 - camX, y * T - 13 - camY),
            });
          } else if (t === FENCE)
            objs.push({ y: (y + 1) * T, draw: () => ctx.drawImage(SPR.fence, x * T - camX, y * T - 2 - camY) });
        }

      const step = player.moving ? 1 + (Math.floor((time - player.t0) / (SPEED / 2)) % 2) : 0;
      objs.push({
        y: player.y + T,
        draw: () => {
          const sx = Math.round(player.x - camX), sy = Math.round(player.y - camY);
          ctx.fillStyle = 'rgba(0,0,0,0.25)';
          ctx.fillRect(sx + 3, sy + 12, 10, 3);
          const set = player.dir === 'left' || player.dir === 'right' ? SPR.player.side : SPR.player[player.dir as 'up' | 'down'];
          const img = set[step];
          if (player.dir === 'right') {
            ctx.save(); ctx.translate(sx + T, sy - 6); ctx.scale(-1, 1);
            ctx.drawImage(img, 0, 0); ctx.restore();
          } else ctx.drawImage(img, sx, sy - 6);
        },
      });

      objs.sort((a, b) => a.y - b.y).forEach((o) => o.draw());

      // warm light + vignette, Stardew-afternoon mood
      ctx.fillStyle = 'rgba(255,214,140,0.06)';
      ctx.fillRect(0, 0, VW, VH);
      const vg = ctx.createRadialGradient(VW / 2, VH / 2, Math.min(VW, VH) * 0.45, VW / 2, VH / 2, Math.max(VW, VH) * 0.75);
      vg.addColorStop(0, 'rgba(0,0,0,0)');
      vg.addColorStop(1, 'rgba(24,14,4,0.32)');
      ctx.fillStyle = vg;
      ctx.fillRect(0, 0, VW, VH);
      requestAnimationFrame(frame);
    }
    updateDialog();
    requestAnimationFrame(frame);
  </script>
</Base>
