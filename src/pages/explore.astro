---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { postHref } from '../lib/paths.mjs';
import { visiblePosts } from '../lib/visibility.mjs';

const base = import.meta.env.BASE_URL;
const posts = visiblePosts(await getCollection('posts'));

function kindOf(p: (typeof posts)[number]) {
  if (p.data.series === 'eeme') return p.data.chapter ? 'chapter' : 'companion';
  if (p.data.icon === 'gb') return 'gb';
  return 'other';
}
const order = { chapter: 0, companion: 1, gb: 2, other: 3 } as const;
const town = posts
  .map((p) => ({
    title: p.data.title,
    href: postHref(p.id, base),
    kind: kindOf(p),
    tag:
      kindOf(p) === 'chapter'
        ? `Book, chapter ${p.data.chapter}`
        : kindOf(p) === 'companion'
          ? 'Book companion'
          : kindOf(p) === 'gb'
            ? 'GB market'
            : 'Note',
    sort: order[kindOf(p)] * 1000 + (p.data.chapter ?? 99),
  }))
  .sort((a, b) => a.sort - b.sort)
  .map(({ sort, ...rest }) => rest);
---

<Base title="Catalog Town" description="Walk around the knowledge catalog. Every house is a post.">
  <div class="not-prose">
    <h1 class="text-[2rem] leading-tight font-bold tracking-[-0.02em]">
      Catalog Town
    </h1>
    <p class="text-muted-foreground mt-2 text-sm">
      Every house is a post. Walk to a door and press Enter to read it.
      Arrow keys or WASD to move; on touch screens use the pad.
    </p>

    <div id="town-frame" class="border-border relative mt-6 overflow-hidden rounded-xl border bg-[#0d1b12]">
      <canvas id="town" width="480" height="320" class="block w-full" style="image-rendering: pixelated;"></canvas>

      <div id="fade" class="pointer-events-none absolute inset-0 bg-black opacity-0 transition-opacity duration-300"></div>

      <div id="pad" class="absolute bottom-3 left-3 hidden select-none" aria-hidden="true">
        <div class="grid grid-cols-3 gap-1 opacity-80">
          <span></span>
          <button data-dir="up" class="pad-btn">▲</button>
          <span></span>
          <button data-dir="left" class="pad-btn">◀</button>
          <span></span>
          <button data-dir="right" class="pad-btn">▶</button>
          <span></span>
          <button data-dir="down" class="pad-btn">▼</button>
          <span></span>
        </div>
      </div>
      <button id="abtn" class="pad-btn absolute right-3 bottom-3 hidden h-12 w-12 rounded-full text-sm font-bold" aria-hidden="true">
        A
      </button>
    </div>

    <div
      id="dialog"
      class="mt-3 min-h-[3.5rem] rounded-lg border-2 border-[#384048] bg-[#f8f8f0] px-4 py-2.5 font-mono text-sm leading-snug text-[#22282e] dark:border-[#c8ccd0]"
    >
    </div>

    <div class="text-muted-foreground mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
      <span class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-sm" style="background:#2b4d7e"></span> Book chapters</span>
      <span class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-sm" style="background:#b4531f"></span> Companion posts</span>
      <span class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-sm" style="background:#0f6b5e"></span> GB market</span>
      <span class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-sm" style="background:#8a4a68"></span> Other notes</span>
    </div>
  </div>

  <script type="application/json" id="town-data" set:html={JSON.stringify(town)} />

  <style>
    .pad-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 0.5rem;
      background: rgba(20, 28, 24, 0.72);
      color: #f0f4ee;
      border: 1px solid rgba(240, 244, 238, 0.35);
      touch-action: none;
    }
    @media (pointer: coarse) {
      #pad,
      #abtn {
        display: grid;
      }
      #abtn {
        display: flex;
      }
    }
  </style>

  <script>
    type Post = { title: string; href: string; kind: string; tag: string };
    const POSTS: Post[] = JSON.parse(
      document.getElementById('town-data')!.textContent!,
    );

    /* ---------- world generation ---------- */
    const T = 16;
    const PER_ROW = 3;
    const bRows = Math.ceil(POSTS.length / PER_ROW);
    const COLS = 4 + PER_ROW * 10;
    const ROWS = 6 + bRows * 9 + 6;

    // tile ids
    const G = 0, PATH = 1, TREE = 2, WATER = 3, FLOWER = 4, SOLID = 5, DOOR = 7, SIGN = 8;

    const grid: number[][] = Array.from({ length: ROWS }, () =>
      Array(COLS).fill(G),
    );
    const doorAt = new Map<string, number>();
    const signAt = new Map<string, number>();
    type Building = { x: number; y: number; kind: string };
    const buildings: Building[] = [];

    function rng(seed: number) {
      let a = seed;
      return () => {
        a |= 0; a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const rand = rng(20260912);

    // tree border, two rings
    for (let y = 0; y < ROWS; y++)
      for (let x = 0; x < COLS; x++)
        if (y < 2 || y >= ROWS - 2 || x < 2 || x >= COLS - 2) grid[y][x] = TREE;

    // buildings + their path rows
    POSTS.forEach((p, i) => {
      const r = Math.floor(i / PER_ROW);
      const c = i % PER_ROW;
      const bx = 4 + c * 10;
      const by = 4 + r * 9;
      buildings.push({ x: bx, y: by, kind: p.kind });
      for (let yy = by; yy < by + 4; yy++)
        for (let xx = bx; xx < bx + 5; xx++) grid[yy][xx] = SOLID;
      grid[by + 3][bx + 2] = DOOR;
      doorAt.set(`${bx + 2},${by + 3}`, i);
      const py = by + 4;
      for (let xx = 3; xx < COLS - 3; xx++) grid[py][xx] = PATH;
      // sign on the grass beside the door, not blocking the path
      grid[by + 3][bx - 1] = SIGN;
      signAt.set(`${bx - 1},${by + 3}`, i);
    });

    // main vertical path + plaza at the bottom
    const cx = Math.floor(COLS / 2);
    for (let yy = 4; yy < ROWS - 3; yy++)
      if (grid[yy][cx] === G || grid[yy][cx] === FLOWER) grid[yy][cx] = PATH;
    for (let yy = ROWS - 5; yy < ROWS - 2; yy++)
      for (let xx = cx - 2; xx <= cx + 2; xx++)
        if (grid[yy][xx] === G) grid[yy][xx] = PATH;

    // pond, bottom left
    for (let yy = ROWS - 6; yy < ROWS - 3; yy++)
      for (let xx = 4; xx < 9; xx++)
        if (grid[yy][xx] === G) grid[yy][xx] = WATER;

    // flowers and loose trees on remaining grass
    for (let y = 2; y < ROWS - 2; y++)
      for (let x = 2; x < COLS - 2; x++) {
        if (grid[y][x] !== G) continue;
        const v = rand();
        if (v < 0.05) grid[y][x] = FLOWER;
        else if (v < 0.075 && y > 5) grid[y][x] = TREE;
      }

    const blocked = (x: number, y: number) => {
      if (x < 0 || y < 0 || x >= COLS || y >= ROWS) return true;
      const t = grid[y][x];
      return t === TREE || t === WATER || t === SOLID || t === SIGN;
    };

    /* ---------- rendering ---------- */
    const canvas = document.getElementById('town') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    ctx.imageSmoothingEnabled = false;
    const VW = canvas.width, VH = canvas.height;

    const ROOF: Record<string, [string, string]> = {
      chapter: ['#2b4d7e', '#1d3557'],
      companion: ['#b4531f', '#8a3c12'],
      gb: ['#0f6b5e', '#0a4c43'],
      other: ['#8a4a68', '#66344c'],
    };

    function drawTile(x: number, y: number, sx: number, sy: number, t: number, time: number) {
      // grass base everywhere
      ctx.fillStyle = (x + y) % 2 ? '#7ec850' : '#86ce58';
      ctx.fillRect(sx, sy, T, T);
      if (t === G || t === SOLID) {
        if ((x * 7 + y * 13) % 5 === 0) {
          ctx.fillStyle = '#74bd48';
          ctx.fillRect(sx + 4, sy + 6, 2, 2);
          ctx.fillRect(sx + 10, sy + 11, 2, 2);
        }
      } else if (t === PATH) {
        ctx.fillStyle = '#e8d5a3';
        ctx.fillRect(sx, sy, T, T);
        ctx.fillStyle = '#d9c48d';
        ctx.fillRect(sx, sy + T - 2, T, 2);
        if ((x * 3 + y * 5) % 4 === 0) {
          ctx.fillStyle = '#cfba82';
          ctx.fillRect(sx + 5, sy + 5, 3, 2);
        }
      } else if (t === TREE) {
        ctx.fillStyle = '#5d4030';
        ctx.fillRect(sx + 6, sy + 10, 4, 5);
        ctx.fillStyle = '#1d6a2e';
        ctx.fillRect(sx + 2, sy + 2, 12, 9);
        ctx.fillStyle = '#2e8b40';
        ctx.fillRect(sx + 3, sy + 1, 7, 6);
        ctx.fillStyle = '#17542a';
        ctx.fillRect(sx + 10, sy + 7, 4, 4);
      } else if (t === WATER) {
        ctx.fillStyle = '#4aa3df';
        ctx.fillRect(sx, sy, T, T);
        const ph = Math.floor(time / 500 + (x + y)) % 3;
        ctx.fillStyle = '#7cc0ea';
        ctx.fillRect(sx + 2 + ph * 3, sy + 4, 4, 1);
        ctx.fillRect(sx + 8 - ph * 2, sy + 11, 4, 1);
      } else if (t === FLOWER) {
        const red = (x * 11 + y * 17) % 3 === 0;
        ctx.fillStyle = red ? '#e5533f' : '#f2d24b';
        ctx.fillRect(sx + 5, sy + 5, 3, 3);
        ctx.fillRect(sx + 10, sy + 9, 3, 3);
        ctx.fillStyle = '#f8f8f0';
        ctx.fillRect(sx + 6, sy + 6, 1, 1);
        ctx.fillRect(sx + 11, sy + 10, 1, 1);
      }
    }

    function drawBuilding(b: Building, camX: number, camY: number, active: boolean) {
      const sx = b.x * T - camX, sy = b.y * T - camY;
      const w = 5 * T, roofH = 2 * T, wallH = 2 * T;
      if (sx + w < 0 || sx > VW || sy + roofH + wallH < 0 || sy > VH) return;
      const [roof, trim] = ROOF[b.kind] ?? ROOF.other;
      // wall
      ctx.fillStyle = '#f2e3c2';
      ctx.fillRect(sx, sy + roofH, w, wallH);
      ctx.fillStyle = '#d9c49b';
      ctx.fillRect(sx, sy + roofH + wallH - 3, w, 3);
      // windows
      ctx.fillStyle = '#8fc7e8';
      ctx.fillRect(sx + 8, sy + roofH + 6, 10, 9);
      ctx.fillRect(sx + w - 18, sy + roofH + 6, 10, 9);
      ctx.strokeStyle = '#7a5a3a';
      ctx.lineWidth = 1;
      ctx.strokeRect(sx + 8.5, sy + roofH + 6.5, 9, 8);
      ctx.strokeRect(sx + w - 17.5, sy + roofH + 6.5, 9, 8);
      // door
      const dx = sx + 2 * T, dy = sy + roofH + wallH - T - 2;
      ctx.fillStyle = '#6b4326';
      ctx.fillRect(dx + 2, dy, T - 4, T + 2);
      ctx.fillStyle = '#4c2e18';
      ctx.fillRect(dx + 2, dy, T - 4, 2);
      if (active) {
        ctx.fillStyle = '#fff3b0';
        ctx.fillRect(dx + 4, dy + 3, T - 8, 4);
      }
      // roof
      ctx.fillStyle = roof;
      ctx.fillRect(sx - 2, sy + 6, w + 4, roofH - 6);
      ctx.fillStyle = trim;
      ctx.fillRect(sx - 2, sy + roofH - 4, w + 4, 4);
      ctx.fillStyle = roof;
      ctx.fillRect(sx + 6, sy, w - 12, 8);
      ctx.fillStyle = '#ffffff22';
      ctx.fillRect(sx - 2, sy + 6, w + 4, 2);
    }

    function drawSign(x: number, y: number, camX: number, camY: number) {
      const sx = x * T - camX, sy = y * T - camY;
      ctx.fillStyle = '#5d4030';
      ctx.fillRect(sx + 7, sy + 8, 3, 7);
      ctx.fillStyle = '#a87c4f';
      ctx.fillRect(sx + 2, sy + 2, 12, 7);
      ctx.fillStyle = '#7a5a3a';
      ctx.fillRect(sx + 4, sy + 4, 8, 1);
      ctx.fillRect(sx + 4, sy + 6, 6, 1);
    }

    /* ---------- player ---------- */
    const SKIN = '#f0c8a0', HAIR = '#5a3a24', COAT = '#2b4d7e', LEGS = '#3a3f47';
    function drawPlayer(px: number, py: number, dir: string, step: number) {
      const x = Math.round(px), y = Math.round(py);
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.fillRect(x + 3, y + 13, 10, 3);
      const legL = step === 1 ? 2 : 0, legR = step === 1 ? 0 : 2;
      ctx.fillStyle = LEGS;
      ctx.fillRect(x + 4, y + 9 + legL / 2, 3, 5 - legL / 2);
      ctx.fillRect(x + 9, y + 9 + legR / 2, 3, 5 - legR / 2);
      ctx.fillStyle = COAT;
      ctx.fillRect(x + 3, y + 5, 10, 5);
      if (dir === 'left') ctx.fillRect(x + 2, y + 6, 2, 3);
      if (dir === 'right') ctx.fillRect(x + 12, y + 6, 2, 3);
      ctx.fillStyle = SKIN;
      ctx.fillRect(x + 4, y, 8, 6);
      ctx.fillStyle = HAIR;
      ctx.fillRect(x + 3, y - 1, 10, 3);
      if (dir === 'up') ctx.fillRect(x + 4, y, 8, 5);
      if (dir === 'left') ctx.fillRect(x + 3, y, 3, 5);
      if (dir === 'right') ctx.fillRect(x + 10, y, 3, 5);
      if (dir === 'down') {
        ctx.fillStyle = '#22282e';
        ctx.fillRect(x + 6, y + 3, 1, 2);
        ctx.fillRect(x + 9, y + 3, 1, 2);
      }
      if (dir === 'left') {
        ctx.fillStyle = '#22282e';
        ctx.fillRect(x + 4, y + 3, 1, 2);
      }
      if (dir === 'right') {
        ctx.fillStyle = '#22282e';
        ctx.fillRect(x + 11, y + 3, 1, 2);
      }
    }

    /* ---------- game state ---------- */
    const player = {
      tx: cx, ty: ROWS - 4,
      x: cx * T, y: (ROWS - 4) * T,
      dir: 'up' as string,
      moving: false, from: [0, 0], to: [0, 0], t0: 0,
    };
    const SPEED = 170; // ms per tile
    const held = new Set<string>();
    const dialog = document.getElementById('dialog')!;
    const fade = document.getElementById('fade')!;
    let leaving = false;

    const DIRS: Record<string, [number, number]> = {
      up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0],
    };

    function tryMove(dir: string) {
      if (player.moving || leaving) return;
      player.dir = dir;
      const [dx, dy] = DIRS[dir];
      const nx = player.tx + dx, ny = player.ty + dy;
      if (blocked(nx, ny)) return;
      player.moving = true;
      player.from = [player.tx * T, player.ty * T];
      player.to = [nx * T, ny * T];
      player.tx = nx; player.ty = ny;
      player.t0 = performance.now();
    }

    function currentPost(): Post | null {
      const onDoor = doorAt.get(`${player.tx},${player.ty}`);
      if (onDoor !== undefined) return POSTS[onDoor];
      // facing a sign?
      const [dx, dy] = DIRS[player.dir];
      const s = signAt.get(`${player.tx + dx},${player.ty + dy}`);
      if (s !== undefined) return POSTS[s];
      return null;
    }

    function enter() {
      const p = currentPost();
      if (!p || leaving) return;
      leaving = true;
      fade.style.opacity = '1';
      setTimeout(() => (window.location.href = p.href), 320);
    }

    function updateDialog() {
      const p = currentPost();
      if (p) {
        dialog.innerHTML = `<span style="opacity:.6">${p.tag}</span><br><strong>${p.title}</strong> · press <kbd>Enter</kbd> (or A) to read`;
      } else {
        dialog.innerHTML =
          'Welcome to Catalog Town. Walk up to a door and press <kbd>Enter</kbd> to read that post.';
      }
    }

    /* ---------- input ---------- */
    const KEYMAP: Record<string, string> = {
      ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
      w: 'up', s: 'down', a: 'left', d: 'right',
      W: 'up', S: 'down', A: 'left', D: 'right',
    };
    window.addEventListener('keydown', (e) => {
      const d = KEYMAP[e.key];
      if (d) { held.add(d); tryMove(d); e.preventDefault(); }
      if (e.key === 'Enter' || e.key === ' ') { enter(); e.preventDefault(); }
    });
    window.addEventListener('keyup', (e) => {
      const d = KEYMAP[e.key];
      if (d) held.delete(d);
    });
    document.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => {
      const d = b.dataset.dir!;
      b.addEventListener('pointerdown', (e) => { e.preventDefault(); held.add(d); });
      for (const ev of ['pointerup', 'pointerleave', 'pointercancel'])
        b.addEventListener(ev, () => held.delete(d));
    });
    document.getElementById('abtn')!.addEventListener('pointerdown', (e) => {
      e.preventDefault(); enter();
    });

    /* ---------- main loop ---------- */
    function frame(time: number) {
      if (player.moving) {
        const k = Math.min((time - player.t0) / SPEED, 1);
        player.x = player.from[0] + (player.to[0] - player.from[0]) * k;
        player.y = player.from[1] + (player.to[1] - player.from[1]) * k;
        if (k >= 1) { player.moving = false; updateDialog(); }
      }
      if (!player.moving) {
        for (const d of ['up', 'down', 'left', 'right'])
          if (held.has(d)) { tryMove(d); break; }
      }

      const camX = Math.max(0, Math.min(player.x - VW / 2 + T / 2, COLS * T - VW));
      const camY = Math.max(0, Math.min(player.y - VH / 2 + T / 2, ROWS * T - VH));

      const x0 = Math.floor(camX / T), y0 = Math.floor(camY / T);
      for (let y = y0; y <= y0 + VH / T; y++)
        for (let x = x0; x <= x0 + VW / T; x++) {
          if (x < 0 || y < 0 || x >= COLS || y >= ROWS) continue;
          drawTile(x, y, x * T - camX, y * T - camY, grid[y][x], time);
        }

      const active = currentPost();
      buildings.forEach((b, i) => {
        const isActive = !!active && POSTS.indexOf(active) === i;
        drawBuilding(b, camX, camY, isActive);
      });
      signAt.forEach((_, key) => {
        const [x, y] = key.split(',').map(Number);
        drawSign(x, y, camX, camY);
      });

      const step = player.moving ? (Math.floor((time - player.t0) / (SPEED / 2)) % 2) : 0;
      drawPlayer(player.x - camX + 0, player.y - camY - 2, player.dir, step);

      requestAnimationFrame(frame);
    }
    updateDialog();
    requestAnimationFrame(frame);
  </script>
</Base>
