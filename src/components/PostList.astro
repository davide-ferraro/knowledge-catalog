---
import type { CollectionEntry } from 'astro:content';
import { postHref } from '../lib/paths.mjs';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="mt-10 space-y-1">
  {
    posts.map((post) => (
      <li>
        <a
          href={postHref(post.id, base)}
          class="hover:bg-accent/60 -mx-3 block rounded-lg px-3 py-3 transition-colors"
        >
          <div class="flex items-baseline gap-3">
            <span class="font-medium">{post.data.title}</span>
            <time
              datetime={post.data.date.toISOString()}
              class="text-muted-foreground ml-auto shrink-0 text-xs tabular-nums"
            >
              {post.data.date.toISOString().slice(0, 10)}
            </time>
          </div>
          {post.data.description && (
            <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
              {post.data.description}
            </p>
          )}
        </a>
      </li>
    ))
  }
</ul>
