---
interface Props {
  title: string;
  /** Start expanded. */
  open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details
  class="not-prose border-border group my-4 rounded-lg border px-4 py-3 [&[open]]:pb-4"
  open={open}
>
  <summary
    class="hover:text-muted-foreground -mx-1 flex cursor-pointer list-none items-center gap-2 px-1 text-[0.9375rem] font-medium transition-colors [&::-webkit-details-marker]:hidden"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-muted-foreground size-3.5 shrink-0 transition-transform duration-150 group-open:rotate-90"
      aria-hidden="true"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
    {title}
  </summary>
  <div class="mt-3 text-[0.9375rem] leading-relaxed">
    <slot />
  </div>
</details>
