---
/**
 * Live counters running at the paper's measured mean hourly welfare losses
 * on the Kontek Cable: €3,246/h under volume coupling (attempt 2) versus
 * €67/h after one-way coordination (attempt 3). Counts up from the moment
 * the reader opens the page. Frozen when the user prefers reduced motion.
 */
---

<figure class="not-prose border-border my-6 rounded-lg border p-4 sm:p-5" data-lt>
  <p class="text-sm font-medium">
    What those rates mean while you read this post
  </p>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <div class="border-border rounded-md border p-3">
      <p class="text-muted-foreground text-xs tracking-wide uppercase">
        At attempt 2's rate (€3,246 lost per hour)
      </p>
      <p class="mt-1 font-mono text-2xl font-bold" style="color: var(--chart-5)" data-lt-fast>
        €0.00
      </p>
    </div>
    <div class="border-border rounded-md border p-3">
      <p class="text-muted-foreground text-xs tracking-wide uppercase">
        At attempt 3's rate (€67 lost per hour)
      </p>
      <p class="mt-1 font-mono text-2xl font-bold" style="color: var(--chart-2)" data-lt-slow>
        €0.00
      </p>
    </div>
  </div>
  <figcaption class="text-muted-foreground mt-3 border-t pt-3 text-xs leading-relaxed">
    Wasted welfare since you opened this page, at the mean hourly losses the
    paper measured for the second and third implementations. One cable,
    550 MW, the same physics: the only difference between the two counters is
    market design.
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-lt]').forEach((root) => {
    const fast = root.querySelector<HTMLElement>('[data-lt-fast]')!;
    const slow = root.querySelector<HTMLElement>('[data-lt-slow]')!;
    const start = Date.now();
    const fmt = (v: number) =>
      `€${v.toLocaleString('en', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // A static comparison instead of a running counter.
      fast.textContent = '€3,246 / hour';
      slow.textContent = '€67 / hour';
      return;
    }

    function tick() {
      const hours = (Date.now() - start) / 3_600_000;
      fast.textContent = fmt(3246 * hours);
      slow.textContent = fmt(67 * hours);
    }
    tick();
    // Skip updates while the tab is hidden; catch up on return.
    setInterval(() => {
      if (!document.hidden) tick();
    }, 100);
  });
</script>
