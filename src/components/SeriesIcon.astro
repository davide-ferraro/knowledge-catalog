---
/**
 * Series icon for the EEME book notes ("night grid" design): the book
 * cover's satellite Europe reduced to a constellation of glowing nodes on a
 * night gradient, with the chapter number bottom-right.
 */
interface Props {
  chapter?: number;
  /** Rendered size in px. */
  size?: number;
  class?: string;
}

const { chapter, size = 40, class: className } = Astro.props;

const nodes: Array<[number, number]> = [
  [26, 66],
  [38, 48],
  [30, 30],
  [52, 18],
  [56, 42],
  [58, 66],
  [74, 32],
];
const links: Array<[number, number]> = [
  [0, 1], [1, 2], [1, 4], [2, 3], [3, 4], [4, 5], [4, 6], [3, 6], [0, 5],
];
const uid = `si${Math.abs(
  [...(chapter?.toString() ?? '')].reduce((a, c) => a + c.charCodeAt(0), size),
)}`;
const twoDigits = (chapter ?? 0) > 9;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 96 96"
  width={size}
  height={size}
  class={className}
  role="img"
  aria-label={chapter ? `Book series icon, chapter ${chapter}` : 'Book series icon'}
>
  <defs>
    <radialGradient id={`${uid}-bg`} cx="0.38" cy="0.3" r="1.05">
      <stop offset="0" stop-color="#17456b"></stop>
      <stop offset="0.55" stop-color="#0d2033"></stop>
      <stop offset="1" stop-color="#080b0e"></stop>
    </radialGradient>
    <linearGradient id={`${uid}-line`} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#6fb644"></stop>
      <stop offset="1" stop-color="#d9f27e"></stop>
    </linearGradient>
  </defs>
  <rect width="96" height="96" rx="22" fill={`url(#${uid}-bg)`}></rect>
  {
    links.map(([a, b]) => (
      <line
        x1={nodes[a][0]}
        y1={nodes[a][1]}
        x2={nodes[b][0]}
        y2={nodes[b][1]}
        stroke={`url(#${uid}-line)`}
        stroke-width="1.4"
        opacity="0.55"
      />
    ))
  }
  {
    nodes.map(([x, y], i) => (
      <>
        <circle cx={x} cy={y} r="5" fill="#d9f27e" opacity="0.16" />
        <circle cx={x} cy={y} r="2.4" fill={i === 4 ? '#ffb347' : '#d9f27e'} />
      </>
    ))
  }
  {
    chapter && (
      <text
        x="85"
        y="84"
        text-anchor="end"
        font-family="ui-sans-serif, system-ui, sans-serif"
        font-weight="700"
        font-size={twoDigits ? 24 : 27}
        fill="#f5f4ef"
      >
        {chapter}
      </text>
    )
  }
</svg>
