---
/**
 * Interactive CfD payoff for the GB primer. Fixed strike price of £75/MWh;
 * a slider sets the day-ahead reference price and the bar shows how market
 * revenue and CfD payment always sum to the strike.
 */
const STRIKE = 75;
---

<figure class="not-prose border-border my-6 rounded-lg border p-4 sm:p-5" data-cfd>
  <p class="text-sm font-medium">
    A CfD in motion: strike price £{STRIKE}/MWh
  </p>
  <label class="text-muted-foreground mt-2 block text-xs">
    Day-ahead reference price:
    <span class="text-foreground ml-1 font-mono" data-cfd-ref-label></span>
    <input type="range" min="20" max="130" step="5" value="60" data-cfd-ref class="accent-primary mt-1 w-full" />
  </label>

  <svg viewBox="0 0 560 96" class="mt-3 w-full select-none" aria-label="CfD revenue composition bar">
    <line x1="20" y1="64" x2="540" y2="64" stroke="var(--border)" stroke-width="1"></line>
    <rect data-cfd-market x="20" y="34" height="30" fill="var(--chart-1)" opacity="0.8" rx="3"></rect>
    <rect data-cfd-topup x="20" y="34" height="30" fill="var(--chart-2)" opacity="0.8" rx="3"></rect>
    <line data-cfd-strike-line x1="0" x2="0" y1="22" y2="72" stroke="var(--foreground)" stroke-width="1.5" stroke-dasharray="4 3"></line>
    <text data-cfd-strike-text y="16" text-anchor="middle" class="fill-foreground" font-size="10" font-weight="600">strike £{STRIKE}</text>
    <text data-cfd-market-label y="84" class="fill-muted-foreground" font-size="10"></text>
    <text data-cfd-topup-label y="84" class="fill-muted-foreground" font-size="10"></text>
  </svg>

  <p class="mt-1 min-h-[2.5rem] text-sm leading-relaxed" data-cfd-verdict></p>

  <figcaption class="text-muted-foreground mt-2 border-t pt-3 text-xs leading-relaxed">
    Whatever the market does, the generator ends up at the strike. That
    stability is the product: it is what lets a wind farm be financed
    cheaply. The flip side is that the generator stops caring about the
    market price, which is one of the design debates in the REMA world.
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-cfd]').forEach((root) => {
    const STRIKE = 75;
    const X0 = 20;
    const SCALE = (540 - X0) / 130; // px per £ up to £130
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const refEl = root.querySelector<HTMLInputElement>('[data-cfd-ref]')!;

    function render() {
      const ref = Number(refEl.value);
      const topup = STRIKE - ref; // negative = clawback
      q('[data-cfd-ref-label]').textContent = `£${ref}/MWh`;

      const marketW = ref * SCALE;
      const market = q('[data-cfd-market]');
      market.setAttribute('width', String(Math.max(marketW - 2, 0)));

      const topupRect = q('[data-cfd-topup]');
      if (topup >= 0) {
        topupRect.setAttribute('x', String(X0 + marketW));
        topupRect.setAttribute('width', String(topup * SCALE));
        topupRect.setAttribute('fill', 'var(--chart-2)');
      } else {
        topupRect.setAttribute('x', String(X0 + STRIKE * SCALE));
        topupRect.setAttribute('width', String(-topup * SCALE));
        topupRect.setAttribute('fill', 'var(--chart-5)');
      }

      const strikeX = X0 + STRIKE * SCALE;
      q('[data-cfd-strike-line]').setAttribute('x1', String(strikeX));
      q('[data-cfd-strike-line]').setAttribute('x2', String(strikeX));
      q('[data-cfd-strike-text]').setAttribute('x', String(strikeX));

      const ml = q('[data-cfd-market-label]');
      ml.setAttribute('x', String(X0));
      ml.textContent = `market revenue £${ref}`;
      const tl = q('[data-cfd-topup-label]');
      tl.setAttribute('x', String(X0 + Math.min(marketW, STRIKE * SCALE) + 4));
      tl.textContent =
        topup >= 0 ? `CfD top-up £${topup}` : `pays back £${-topup}`;

      q('[data-cfd-verdict]').textContent =
        topup > 0
          ? `Market at £${ref}: the CfD counterparty tops the generator up by £${topup}/MWh to reach the £75 strike.`
          : topup < 0
            ? `Market at £${ref}: above the strike, so the generator pays the £${-topup}/MWh excess back. Consumers gain when prices spike.`
            : 'Market exactly at the strike: the CfD pays nothing either way.';
    }

    refEl.addEventListener('input', render);
    render();
  });
</script>
