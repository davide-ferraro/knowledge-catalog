---
interface Props {
  /** [label, count, href] for each tag or category. */
  entries: Array<[string, number, string]>;
}

const { entries } = Astro.props;
---

<ul class="mt-10 grid gap-2 sm:grid-cols-2">
  {
    entries.map(([label, count, href]) => (
      <li>
        <a
          href={href}
          class="border-border hover:bg-accent/60 flex items-center justify-between rounded-lg border px-4 py-3 transition-colors"
        >
          <span class="text-sm font-medium">{label}</span>
          <span class="text-muted-foreground text-xs tabular-nums">{count}</span>
        </a>
      </li>
    ))
  }
</ul>
